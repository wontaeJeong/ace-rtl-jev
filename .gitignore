# Local benchmark datasets downloaded by setup helpers.
datasets/

# Local package caches created by environment setup.
.conda-pkgs/

# Local Conda/Mamba environments created during native setup.
.cvdp-native/

# Local CVDP checkout and run artifacts.
external/
outputs/

# Python/cache artifacts.
__pycache__/
*.pyc
.pytest_cache/

.env.local
.worktrees/

# Native working copies embed benchmark-private harness source. Keep them local;
# publish per-case evaluator results and API measurement events instead.
experiments/runs/**/native/

# Live atomic spending ledgers are binary and may have WAL sidecars.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Prepared judgment inputs can contain bounded emitted checker diagnostics.
experiments/studies/**/inputs/
