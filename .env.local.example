# Copy to .env.local; never commit credentials. Shell variables take precedence.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Choose after real API preflight. Some reasoning providers require the second.
LLM_TOKEN_PARAMETER=max_completion_tokens
# default omits temperature/top_p; explicit forwards original ACE values.
LLM_SAMPLING_MODE=default
REQUEST_TIMEOUT=60

JEV_API_MODE=systemone
# Full endpoint, not a chat-completions URL.
JEV_ENDPOINT_URL=
JEV_BASE_URL=
JEV_MODEL=
# Explicit policy: none only for an intentionally unauthenticated local server.
JEV_AUTH_MODE=none
JEV_API_KEY=
